# Arc Studio Server
PORT=3000
HOST=127.0.0.1

# Master Setup Credential (Required for initial first-time setup)
# Default "ARC-CHANGETHIS", change this to a secure string.
ARC_SETUP_KEY=ARC-CHANGETHIS

# Session Security
# Defaults "ARC-SESSIONSECRET". Arc Studio automatically generates a secure secret on first launch if default is detected.
SESSION_SECRET=ARC-SESSIONSECRET

# Bot token encryption key. Arc Studio generates and stores a separate key if unset.
# Desktop keeps this key in the operating system credential store.
ARC_BOT_TOKEN_ENCRYPTION_KEY=

# Log File Retention (in days: 1-30, or 'forever')
LOG_RETENTION_DAYS=7

# Allow workspace accounts with bot-control permission to include the bot token in bot exports.
# The primary owner can always include it. When false, only the primary owner sees the option.
ARC_SHOW_BOT_TOKEN_EXPORT_OPTION=true

# Optional legacy default Discord token. On startup ARC Studio encrypts it into
# the active project and removes it from .env. Prefer entering tokens in the UI.
DISCORD_BOT_TOKEN=
