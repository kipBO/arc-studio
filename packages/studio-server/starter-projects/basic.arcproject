{
  "format": "arc-project",
  "version": 1,
  "project": {
    "name": "Community Bot",
    "createdWithVersion": "2026.1.1-alpha.6",
    "starter": {
      "id": "basic",
      "name": "Community Bot",
      "description": "Welcome messages, member tools, reports, and feedback.",
      "icon": "Bot",
      "highlights": [
        "Welcome card with an interactive checklist",
        "Member join and leave messages",
        "Report, feedback, and suggestion forms",
        "Slash commands with live member data",
        "Six rotating bot activities, updated every ten minutes"
      ],
      "setup": [
        "Set welcome-channel-id and community-log-channel-id in Project Variables.",
        "Set each report, feedback, and suggestion channel ID before using its matching form.",
        "Enable the Server Members Intent in Discord and ARC Studio to receive join/leave events.",
        "Edit Bot Presence to change the activity messages and timing."
      ],
      "order": 1
    }
  },
  "files": {
