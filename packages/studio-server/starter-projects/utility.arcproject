          "id": "utility_remind",
          "name": "Slash: /remind",
          "description": "Waits up to ten minutes, then posts a reminder in the command channel.",
          "graphType": "event",
          "variables": [],
          "nodes": [
            {
              "id": "utility_remind_event",
              "type": "event_slash_command",
              "x": 60,
              "y": 120,
              "data": {
                "commandName": "remind",
                "description": "Post a reminder in this channel after a short delay.",
                "options": [
                  {
                    "name": "minutes",
                    "description": "Wait from 1 to 10 minutes.",
                    "type": 4,
                    "required": true,
                    "min_value": 1,
                    "max_value": 10
                  },
                  {
                    "name": "message",
                    "description": "What should the bot remind you about?",
                    "type": 3,
                    "required": true,
                    "max_length": 1000
                  }
                ]
              }
            },
            {
              "id": "utility_remind_defer",
              "type": "action_defer_reply",
              "x": 350,
              "y": 120,
              "data": {
                "ephemeral": true
              }
            },
            {
              "id": "utility_remind_minute",
              "type": "value_number",
              "x": 350,
              "y": 390,
              "data": {
                "value": 60000
              }
            },
            {
              "id": "utility_remind_ms",
              "type": "math_multiply",
              "x": 640,
              "y": 390,
              "data": {}
            },
            {
