{
  "format": "arc-project",
  "version": 1,
  "project": {
    "name": "Utility Bot",
    "createdWithVersion": "2026.1.1-alpha.6",
    "starter": {
      "id": "utility",
      "name": "Utility Bot",
      "description": "Reminders, dice, random picks, and text tools.",
      "icon": "Braces",
      "highlights": [
        "Random range and dice commands",
        "Choice from three live arguments",
        "Delayed reminders with a ten-minute limit",
        "SHA-256 text utility",
        "Private feedback form",
        "Six rotating bot activities, updated every ten minutes"
      ],
      "setup": [
        "Configure utility-feedback-channel-id in Project Variables before using /feedback.",
        "The /remind command waits in memory for up to ten minutes; a server restart cancels pending reminders.",
        "Grant the bot Send Messages and Embed Links in channels where it should respond.",
        "Edit Bot Presence to change the activity messages and timing."
      ],
      "order": 5
    }
  },
  "files": {
