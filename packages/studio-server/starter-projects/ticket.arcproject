                  "components": [
                    {
                      "type": "text",
                      "customId": "ticket_subject",
                      "label": "Short summary",
                      "style": 1,
                      "required": true,
                      "minLength": 3,
                      "maxLength": 100,
                      "placeholder": "What do you need help with?"
                    },
                    {
                      "type": "text",
                      "customId": "ticket_details",
                      "label": "Details",
                      "style": 2,
                      "required": true,
                      "minLength": 10,
                      "maxLength": 1500,
                      "placeholder": "Include the steps and context the team needs."
