{
  "format": "arc-project",
  "version": 1,
  "project": {
    "name": "Ticket App",
    "createdWithVersion": "2026.1.1-alpha.6",
    "starter": {
      "id": "ticket",
      "name": "Ticket App",
      "description": "Open private tickets, manage them with staff commands, and collect feedback.",
      "icon": "Ticket",
      "highlights": [
        "Modal ticket intake with private channel permissions",
        "Optional staff role access",
        "Staff claim and rename commands",
        "Button and slash-command close controls",
        "Private feedback form routed to a configured channel",
        "Six rotating bot activities, updated every ten minutes"
      ],
      "setup": [
        "Set support-staff-role-id to your support role ID. Leave it blank if the bot and ticket opener are the only permitted viewers.",
        "Set support-feedback-channel-id before using /feedback.",
        "The bot needs Manage Channels, View Channels, Send Messages, Read Message History, and Embed Links.",
        "Deploy the included slash commands after connecting the bot.",
        "Edit Bot Presence to change the activity messages and timing."
      ],
      "order": 2
    }
  },
  "files": {
    "graphs.json": {
