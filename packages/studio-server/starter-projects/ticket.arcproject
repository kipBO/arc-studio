                    "type": "title",
                    "value": "Ticket privacy and conduct"
                  },
                  {
                    "id": "support_policy_embed_description",
                    "type": "description",
                    "value": "Tickets are private support channels. Do not submit passwords, authentication codes, payment information, or another person’s private data. Keep one issue per ticket and close it when the team has resolved it."
