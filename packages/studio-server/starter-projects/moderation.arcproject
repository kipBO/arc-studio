{
  "format": "arc-project",
  "version": 1,
  "project": {
    "name": "Moderation Bot",
    "createdWithVersion": "2026.1.1-alpha.6",
    "starter": {
      "id": "moderation",
      "name": "Moderation Bot",
      "description": "Timeout, kick, and ban commands with reports and logs.",
      "icon": "ShieldCheck",
      "highlights": [
        "Timeout, kick, ban, and unban use Discord REST actions",
        "Slash commands require matching Discord permissions",
        "Audit log reasons and clear success/failure replies",
        "Private report and appeal forms",
        "AutoMod and ban event logging",
        "Six rotating bot activities, updated every ten minutes"
      ],
      "setup": [
        "Set moderation-log-channel-id before using reports, appeals, warnings, or case notes.",
        "Grant the bot Moderate Members, Kick Members, and Ban Members as needed; keep its role above members it manages.",
        "Set staff roles and channel access in Discord. Slash command permission gates are not a substitute for bot permissions.",
        "Enable the Auto Moderation Execution and Server Members intents if you want event logs.",
        "Edit Bot Presence to change the activity messages and timing."
      ],
      "order": 3
    }
  },
  "files": {
    "graphs.json": {
      "graphs": [
        {
          "id": "moderation_timeout",
          "name": "Slash: /timeout",
          "description": "Runs timeout with a moderator-only Discord permission gate and an audit-log reason.",
          "graphType": "event",
          "variables": [],
          "nodes": [
            {
              "id": "moderation_timeout_event",
              "type": "event_slash_command",
              "x": 60,
              "y": 120,
              "data": {
                "commandName": "timeout",
                "description": "Timeout a member.",
                "defaultMemberPermissions": "1099511627776",
                "options": [
                  {
                    "name": "member",
                    "description": "Member to time out.",
                    "type": 6,
                    "required": true
                  },
                  {
                    "name": "duration",
                    "description": "Timeout duration in minutes.",
                    "type": 4,
                    "required": true,
                    "min_value": 1,
                    "max_value": 40320
                  },
                  {
                    "name": "reason",
                    "description": "Reason shown in the audit log.",
                    "type": 3,
                    "required": false,
                    "max_length": 500
                  }
                ]
              }
            },
            {
              "id": "moderation_timeout_defer",
              "type": "action_defer_reply",
              "x": 360,
              "y": 120,
              "data": {
                "ephemeral": true
              }
            },
            {
              "id": "moderation_timeout_action",
              "type": "action_moderate_member",
              "x": 700,
              "y": 120,
              "data": {
                "operation": "timeout",
                "duration_minutes": 10
              }
            },
            {
              "id": "moderation_timeout_success_text",
