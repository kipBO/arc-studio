              }
            },
            {
              "id": "moderation_help_embed",
              "type": "build_embed",
              "x": 390,
              "y": 360,
              "data": {
                "blocks": [
                  {
                    "id": "moderation_help_embed_title",
                    "type": "title",
                    "value": "Moderator tools"
                  },
                  {
                    "id": "moderation_help_embed_description",
                    "type": "description",
                    "value": "**Timeout:** /timeout · requires Moderate Members\n**Kick:** /kick · requires Kick Members\n**Ban / unban:** /ban and /unban · requires Ban Members\n**Warn:** /warn · requires Manage Messages\n**Case note:** /case-note · requires Manage Channels\nUse /report and /appeal to route member forms to the configured log channel."
                  },
                  {
                    "id": "moderation_help_embed_color",
                    "type": "color",
                    "value": "#D95B5B"
                  },
                  {
                    "id": "moderation_help_embed_footer",
                    "type": "footer",
                    "value": "The bot also needs the matching server permissions and a role above its targets."
                  }
                ],
                "components": []
              }
            }
          ],
